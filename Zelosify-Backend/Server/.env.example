# PSQL Database Configuration
DATABASE_URL=postgresql://postgres:testrun@localhost:5445/zelosify_recruit_test?schema=app

# JWT Configuration
JWT_SECRET=your_jwt_secret_hex_64_chars

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=your_encryption_key_hex_64_chars

# Environment
NODE_ENV=development

# Storage Configuration
STORAGE_PROVIDER=aws

# AWS S3 Configuration
S3_AWS_REGION=us-east-1
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=zel-recruit

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=Zelosify
KEYCLOAK_CLIENT_ID=dynamic-client
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_RS256_SIG=your_keycloak_rs256_signature

# Security & Sessions
SESSION_SECRET=your_session_secret_hex_64_chars

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# LLM Agent Configuration (Groq or Gemini)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
